{
	"$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
	"Name": "Wardeck",
	"Version": "0.4.0.0",
	"Author": "JazzActual",
	"Actions": [
		{
			"Name": "Stat",
			"UUID": "com.jazzactual.wardeck.stat",
			"Icon": "imgs/actions/stat/icon",
			"Tooltip": "Shows a configurable WiGLE, WDGWars, or Wardrift statistic.",
			"PropertyInspectorPath": "ui/stat.html",
			"Controllers": ["Keypad"],
			"States": [
				{
					"Image": "imgs/actions/stat/key",
					"TitleAlignment": "middle",
					"FontSize": 14
				}
			]
		},
		{
			"Name": "Platform Summary",
			"UUID": "com.jazzactual.wardeck.platform-summary",
			"Icon": "imgs/actions/platform-summary/icon",
			"Tooltip": "Shows a platform logo and primary metric; opens the platform site on press.",
			"PropertyInspectorPath": "ui/platform-summary.html",
			"Controllers": ["Keypad"],
			"States": [
				{
					"Image": "imgs/actions/platform-summary/key",
					"TitleAlignment": "middle",
					"FontSize": 12
				}
			]
		},
		{
			"Name": "Wardrift Banner",
			"UUID": "com.jazzactual.wardeck.wardrift-banner",
			"Icon": "imgs/actions/wardrift-banner/icon",
			"Tooltip": "Composed Wardrift banner across all four Stream Deck+ dials (display-only).",
			"Controllers": ["Encoder"],
			"Encoder": {
				"layout": "layouts/composed-banner.json"
			},
			"States": [
				{
					"Image": "imgs/actions/wardrift-banner/key"
				}
			]
		},
		{
			"Name": "WiGLE Banner",
			"UUID": "com.jazzactual.wardeck.wigle-banner",
			"Icon": "imgs/actions/wigle-banner/icon",
			"Tooltip": "Composed WiGLE banner across all four Stream Deck+ dials (display-only).",
			"Controllers": ["Encoder"],
			"Encoder": {
				"layout": "layouts/composed-banner.json"
			},
			"States": [
				{
					"Image": "imgs/actions/wigle-banner/key"
				}
			]
		},
		{
			"Name": "WDGWars Banner",
			"UUID": "com.jazzactual.wardeck.wdgwars-banner",
			"Icon": "imgs/actions/wdgwars-banner/icon",
			"Tooltip": "Composed WDGWars banner across all four Stream Deck+ dials (display-only).",
			"Controllers": ["Encoder"],
			"Encoder": {
				"layout": "layouts/composed-banner.json"
			},
			"States": [
				{
					"Image": "imgs/actions/wdgwars-banner/key"
				}
			]
		}
	],
	"Category": "Wardeck",
	"CategoryIcon": "imgs/plugin/category-icon",
	"CodePath": "bin/plugin.js",
	"Description": "Live wardriving statistics from WiGLE, WDGWars, and Wardrift on your Stream Deck.",
	"Icon": "imgs/plugin/marketplace",
	"SDKVersion": 3,
	"Software": {
		"MinimumVersion": "7.1"
	},
	"OS": [
		{
			"Platform": "mac",
			"MinimumVersion": "12"
		},
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		}
	],
	"Nodejs": {
		"Version": "24",
		"Debug": "enabled"
	},
	"UUID": "com.jazzactual.wardeck",
	"Profiles": [
		{
			"Name": "profiles/Wardeck",
			"DeviceType": 7,
			"Readonly": false,
			"DontAutoSwitchWhenInstalled": false,
			"AutoInstall": true
		}
	]
}
